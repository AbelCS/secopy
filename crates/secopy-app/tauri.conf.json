{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Secopy",
  "identifier": "com.latecommits.secopy",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../../ui" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../../ui" }
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Secopy",
        "visible": false,
        "width": 900,
        "height": 780,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "copyright": "Copyright © 2026 Abel Castro Suárez. GPL-3.0-or-later.",
    "active": true,
    "targets": ["dmg"],
    "category": "Utility",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "macOS": {
      "signingIdentity": "-",
      "files": {
        "Resources/en.lproj/InfoPlist.strings": "./infoplist/en.lproj/InfoPlist.strings",
        "Resources/es.lproj/InfoPlist.strings": "./infoplist/es.lproj/InfoPlist.strings"
      }
    },
    "fileAssociations": [
      {
        "ext": ["secopy"],
        "name": "Secopy settings",
        "description": "Secopy settings and presets",
        "role": "Editor",
        "mimeType": "application/json",
        "exportedType": {
          "identifier": "com.latecommits.secopy.settings",
          "conformsTo": ["public.json"]
        }
      }
    ]
  }
}
